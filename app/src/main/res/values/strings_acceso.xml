    <!-- ===================== Ayuda (ayu_) ===================== -->
    <string name="ayu_titulo">Ayuda y soporte</string>
    <string name="ayu_encabezado">¿En qué te ayudamos?</string>
    <string name="ayu_faq_titulo">Preguntas frecuentes</string>

    <string name="ayu_faq_pedido_pregunta">¿Cómo hago un pedido?</string>
    <string name="ayu_faq_pedido_respuesta">Elige productos en el catálogo, agrégalos al carrito y confirma. Recibirás un folio para seguir tu pedido.</string>
    <string name="ayu_faq_sin_internet_pregunta">¿Puedo pedir sin internet?</string>
    <string name="ayu_faq_sin_internet_respuesta">Sí. El pedido se guarda en el teléfono y se envía a la panadería en cuanto vuelve la conexión.</string>
    <string name="ayu_faq_seguimiento_pregunta">¿Cómo sigo mi pedido?</string>
    <string name="ayu_faq_seguimiento_respuesta">En la pestaña Pedido verás el avance: recibido, en preparación, en camino y entregado. Toca ⟳ para actualizar.</string>
    <string name="ayu_faq_pagos_pregunta">¿Qué formas de pago aceptan?</string>
    <string name="ayu_faq_pagos_respuesta">Efectivo al recibir, tarjeta con la terminal del repartidor y transferencia SPEI. Se eligen en Perfil → Métodos de pago.</string>
    <string name="ayu_faq_envio_pregunta">¿Cuánto cuesta el envío?</string>
    <string name="ayu_faq_envio_respuesta">El envío a domicilio cuesta $30 dentro de Acámbaro y es gratis en pedidos de $250 o más. Recoger en la panadería no tiene costo.</string>
    <string name="ayu_faq_direccion_pregunta">¿Cómo cambio mi dirección?</string>
    <string name="ayu_faq_direccion_respuesta">En Perfil → Direcciones de entrega puedes agregar, editar y marcar tu dirección predeterminada.</string>
    <string name="ayu_faq_no_llega_pregunta">¿Qué hago si mi pedido no llega?</string>
    <string name="ayu_faq_no_llega_respuesta">Llama a la panadería o escríbenos; con tu folio podemos revisar el estado y al repartidor asignado.</string>

    <string name="ayu_contacto_titulo">Contacto</string>
