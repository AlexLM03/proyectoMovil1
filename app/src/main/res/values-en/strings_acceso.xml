    <!-- ===================== Help (ayu_) ===================== -->
    <string name="ayu_titulo">Help and support</string>
    <string name="ayu_encabezado">How can we help you?</string>
    <string name="ayu_faq_titulo">Frequently asked questions</string>

    <string name="ayu_faq_pedido_pregunta">How do I place an order?</string>
    <string name="ayu_faq_pedido_respuesta">Pick products in the catalog, add them to the cart and confirm. You will receive an order number to track your order.</string>
    <string name="ayu_faq_sin_internet_pregunta">Can I order without internet?</string>
    <string name="ayu_faq_sin_internet_respuesta">Yes. The order is saved on your phone and sent to the bakery as soon as the connection comes back.</string>
    <string name="ayu_faq_seguimiento_pregunta">How do I track my order?</string>
    <string name="ayu_faq_seguimiento_respuesta">In the Order tab you will see the progress: received, being prepared, on the way and delivered. Tap ⟳ to refresh.</string>
    <string name="ayu_faq_pagos_pregunta">Which payment methods do you accept?</string>
    <string name="ayu_faq_pagos_respuesta">Cash on delivery, card with the driver terminal and SPEI bank transfer. You pick one in Profile → Payment methods.</string>
    <string name="ayu_faq_envio_pregunta">How much does delivery cost?</string>
    <string name="ayu_faq_envio_respuesta">Home delivery costs $30 inside Acámbaro and is free on orders of $250 or more. Picking up at the bakery is free.</string>
    <string name="ayu_faq_direccion_pregunta">How do I change my address?</string>
    <string name="ayu_faq_direccion_respuesta">In Profile → Delivery addresses you can add, edit and set your default address.</string>
    <string name="ayu_faq_no_llega_pregunta">What if my order does not arrive?</string>
    <string name="ayu_faq_no_llega_respuesta">Call the bakery or write to us; with your order number we can check the status and the assigned driver.</string>

    <string name="ayu_contacto_titulo">Contact</string>
