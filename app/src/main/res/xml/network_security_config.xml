<?xml version="1.0" encoding="utf-8"?>
<!--
    La API de producción se consume por HTTPS a través del túnel
    (https://acambapan.devnoway.com/api/), así que el tráfico en claro queda
    prohibido por defecto.

    Solo se permite HTTP para las direcciones locales de desarrollo
    (XAMPP en el equipo anfitrión o vía `adb reverse`), que nunca salen del
    equipo y no pueden usar TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
